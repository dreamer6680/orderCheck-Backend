# Copy values into IntelliJ Run Configuration -> Environment variables.
# Spring Boot does not load .env automatically.
DATABASE_URL=jdbc:postgresql://localhost:5432/packflow
DATABASE_USERNAME=packflow
DATABASE_PASSWORD=your-local-postgres-password
JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
# On first startup after V4, if no active real manager exists, configure a distinct account.
APP_BOOTSTRAP_ADMIN_USERNAME=localadmin
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
